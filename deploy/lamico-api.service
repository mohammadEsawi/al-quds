# systemd unit for the Lamico API. Install with:
#   sudo cp deploy/lamico-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lamico-api
#
# Logs: journalctl -u lamico-api -f

[Unit]
Description=Lamico API (Express)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/lamico/server
# server/.env lives here and is loaded by the app itself (dotenv) — nothing to pass via Environment=.
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Light sandboxing: the API only needs to read its own code, write to uploads/, and reach Postgres + the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/lamico/server/uploads /srv/lamico/server/backups
ProtectHome=true

[Install]
WantedBy=multi-user.target
