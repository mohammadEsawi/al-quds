# Copy this file to `.env` and fill in the values. Never commit `.env`.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (create a database named "lamico" first)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lamico?schema=public"
# Optional: a more privileged user used ONLY by `npm run db:migrate` (see README -> Database user).
# MIGRATE_DATABASE_URL="postgresql://OWNER:PASSWORD@localhost:5432/lamico?schema=public"

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_HOURS=8

# Origin allowed by CORS (the React dev server / production domain)
CLIENT_URL=http://localhost:5173

# Public address of the website for sitemap.xml / robots.txt (defaults to CLIENT_URL)
# SITE_URL=https://www.example.com

# Days of dashboard activity (audit log) to keep
AUDIT_RETENTION_DAYS=365

# Extra origins allowed to call the API with the login cookie (comma separated). CLIENT_URL is always allowed.
ALLOWED_ORIGINS=

# Set to true only when running behind a reverse proxy (nginx, Cloudflare, ...)
TRUST_PROXY=false

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_VIDEO_MB=50
MAX_CV_MB=5

# Country code used for local phone numbers in WhatsApp links (970 = Palestine)
DEFAULT_COUNTRY_CODE=970

# First admin account created by `npm run db:seed` (password: 12+ characters).
# Delete ADMIN_PASSWORD from this file once the seed has run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lamico Admin

# ───────────────────────────────────────────────────────────────────────────────
# Optional services — every block below stays OFF until you fill it in.
# Full guide: docs/OPERATIONS.md   (the dashboard checklist shows what is configured)
# ───────────────────────────────────────────────────────────────────────────────

# Email alerts for new applications / messages / quote requests (recipients are set in the dashboard: الإشعارات)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# WhatsApp alerts (Meta WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# An approved message template with two body parameters; needed to reach a number that has not written to you in 24 h
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar

# CAPTCHA on the public forms (Cloudflare Turnstile, free)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Antivirus for uploaded CVs (a ClamAV daemon, e.g. the clamav/clamav Docker image)
CLAMAV_HOST=
CLAMAV_PORT=3310
# true: refuse uploads while the scanner is unreachable
CLAMAV_REQUIRED=false

# Two-factor login
# true: admins and super admins must set it up before using the dashboard
REQUIRE_2FA=false
# 32 random bytes as 64 hex characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Encrypts the authenticator secrets; without it a key is derived from JWT_SECRET.
DATA_ENCRYPTION_KEY=

# Visitor statistics without cookies: plausible | umami
ANALYTICS_PROVIDER=
ANALYTICS_DOMAIN=
ANALYTICS_WEBSITE_ID=
# Google Search Console "HTML tag" verification code
GOOGLE_SITE_VERIFICATION=

# Backups: npm run backup
BACKUP_DIR=backups
BACKUP_KEEP=14
# Encrypts the backup files; keep it somewhere else than this server
BACKUP_PASSPHRASE=
# Folder with pg_dump / pg_restore if they are not on the PATH, e.g. C:/Program Files/PostgreSQL/18/bin
PG_BIN_DIR=
